<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#000000"
    android:padding="24dp">

    <!-- 左栏：标题 + 副标题 + 色块(2x2) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvLab1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lab 1"
            android:textColor="#ffffff"
            android:textSize="34sp"
            android:gravity="center"
            android:paddingVertical="20dp" />

        <TextView
            android:id="@+id/tvResponsive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:text="Responsive Layout 1"
            android:textSize="20sp"
            android:gravity="center"
            android:paddingVertical="20dp" />

        <!-- 第一行色块 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvThis"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="#ff0000"
                android:text="This"
                android:textColor="#ffffff"
                android:gravity="center" />

            <TextView
                android:id="@+id/tvIs"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="#0000ff"
                android:text="is"
                android:textColor="#ffffff"
                android:gravity="center" />
        </LinearLayout>

        <!-- 第二行色块 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvMy"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="#9900cc"
                android:text="my"
                android:textColor="#ffffff"
                android:gravity="center" />

            <TextView
                android:id="@+id/tvFirst"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="#ffff00"
                android:text="first"
                android:textColor="#000000"
                android:gravity="center" />
        </LinearLayout>
    </LinearLayout>

    <!-- 右栏：Android Application + 按钮 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="24dp">

        <TextView
            android:id="@+id/tvAndroidApp"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:text="Android Application"
            android:textColor="#ffffff"
            android:textSize="24sp"
            android:gravity="center" />

        <LinearLayout
            android:id="@+id/bottomBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#f3eef8"
            android:paddingVertical="30dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnChange"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="20dp"
                android:backgroundTint="#7b5bb2"
                android:text="Change"
                android:textColor="#ffffff" />

            <Button
                android:id="@+id/btnCancel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="20dp"
                android:backgroundTint="#7b5bb2"
                android:text="Cancel"
                android:textColor="#ffffff" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
